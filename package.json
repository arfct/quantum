{
  "name": "@arfct/quantum",
  "version": "0.1.0",
  "description": "Quantum, Artifact's design system: inspired by Classic Material Design, with system type, Material Symbols Outlined, the Tailwind palette and squircle corners.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./quantum.css": "./dist/quantum.css",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "npm run build:tokens && npm run build:js && npm run build:styles",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:js": "tsup",
    "build:styles": "node scripts/build-styles.mjs",
    "dev": "npm run build:tokens && vite examples",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "30.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
